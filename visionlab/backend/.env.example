# ───────── App ─────────
APP_ENV=development
# IMPORTANT: generate a real secret with:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ───────── Database ─────────
# Inside docker-compose use service names (postgres). Outside compose use localhost.
DATABASE_URL=postgresql+asyncpg://visionlab:visionlab@localhost:5432/visionlab
SYNC_DATABASE_URL=postgresql://visionlab:visionlab@localhost:5432/visionlab
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ───────── Redis / Celery ─────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ───────── Gemini ─────────
# NEVER commit a real key. Put the real key only in your local .env (which is
# gitignored). Rotate any key that has been pushed to a repo or cloud drive.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_S=12

# ───────── Audio output ─────────
AUDIO_OUTPUT_DIR=audio_outputs

# ───────── CORS ─────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ───────── HuggingFace cache (prevents re-download) ─────────
HF_HOME=./models
HF_HUB_ENABLE_HF_TRANSFER=1

# ───────── PyTorch memory hint ─────────
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
