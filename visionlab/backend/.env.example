# ───────── App ─────────
APP_ENV=development
# IMPORTANT: generate a real secret with:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ───────── Database ─────────
# This .env is for running the app NATIVELY (bare uvicorn/celery on the host),
# not for docker-compose — docker-compose.yml hardcodes its own DATABASE_URL/
# REDIS_URL/CELERY_* as container env vars and never reads this file.
#
# Keep these pointed at a database/Redis-DB-index Docker does NOT use, so a
# native run can never steal Docker's Celery tasks or write output files into
# a directory the Docker api container doesn't serve from. Docker uses the
# `visionlab` database and Redis db 0/1 — use a different database name and
# db 2/3 here. See backend/README.md for the full explanation.
DATABASE_URL=postgresql+asyncpg://visionlab:visionlab@localhost:5432/visionlab_native
SYNC_DATABASE_URL=postgresql://visionlab:visionlab@localhost:5432/visionlab_native
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ───────── Redis / Celery ─────────
REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ───────── Gemini ─────────
# NEVER commit a real key. Put the real key only in your local .env (which is
# gitignored). Rotate any key that has been pushed to a repo or cloud drive.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_S=12

# ───────── Audio output ─────────
AUDIO_OUTPUT_DIR=audio_outputs

# ───────── CORS ─────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ───────── HuggingFace cache (prevents re-download) ─────────
HF_HOME=./models
HF_HUB_ENABLE_HF_TRANSFER=1

# ───────── PyTorch memory hint ─────────
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
